# ──────────────────────────────────────────────────────────────────────────
# Política de versionamento — definida em 2026-11-12
# O conhecimento entra no git. Os bytes regeneráveis, não.
# ──────────────────────────────────────────────────────────────────────────

# Workspaces de negócio (6,9 GB): relatórios, claims, JSON e SRT entram;
# captura e render ficam fora — são regeneráveis pelos pipelines.
workspaces/**/*.jpg
workspaces/**/*.jpeg
workspaces/**/*.png
workspaces/**/*.gif
workspaces/**/*.webp
workspaces/**/*.mp4
workspaces/**/*.mov
workspaces/**/*.mp3
workspaces/**/*.wav
workspaces/**/*.m4a

# Frames de análise do AI Creative Studio (2.519 jpg, 196 MB).
# Agentes, tasks, checklists, workflows, scripts e .md continuam versionados.
squads/oraclumtech-ai-creative-studio/**/*.jpg
squads/oraclumtech-ai-creative-studio/**/*.jpeg
squads/oraclumtech-ai-creative-studio/**/*.png
squads/oraclumtech-ai-creative-studio/**/*.webp
squads/oraclumtech-ai-creative-studio/**/*.mp4
squads/oraclumtech-ai-creative-studio/**/*.mp3
squads/oraclumtech-ai-creative-studio/**/*.wav

# apps/bx: réplica do framework e das configs de agente que já vivem na raiz.
# Só app/ e Squads/ são conteúdo próprio do projeto.
apps/bx/.aiox-core/
apps/bx/.agent/
apps/bx/.agents/
apps/bx/.antigravity/
apps/bx/.claude/
apps/bx/.codex/
apps/bx/.cursor/
apps/bx/.gemini/
apps/bx/.github/
apps/bx/.grok/
apps/bx/.kimi/

# Prints soltos na raiz dos projetos
/image*.png
apps/bx/image*.png

# Distribuição de terceiro desempacotada no repo (yt-dlp + ffmpeg para Windows).
# É baixável e pesa 136 binários; o auto-update dela já era ignorado.
services/ETL/yt-dlp_win/
services/ETL/bin/*.exe

# Live de futebol: diretórios de trabalho com áudio gerado por TTS.
# assets/ (torcida, provas de voz) é curadoria e continua versionado.
apps/live-futebol/_pack/
apps/live-futebol/_falas/
apps/live-futebol/_vozes/
apps/live-futebol/__pycache__/

# ──────────────────────────────────────────────────────────────────────────
# DADO PESSOAL — nunca versionar
# Audiências de Meta Ads contêm e-mail e telefone de pessoas reais em texto
# puro (uma só tem 500 mil registros). Uma vez no histórico do git, é
# praticamente permanente. Os README e a documentação continuam versionados.
# ──────────────────────────────────────────────────────────────────────────
**/meta-ads/audiences/*.csv
**/meta-ads/audiences/*.txt
**/audiencia*.csv
**/audience*.csv
**/leads*.csv
**/contatos*.csv

# Exportações brutas de pedidos da Meta: colunas Nome, Telefone, Email, Cpf e
# IDs de pagamento — identificação completa de clientes reais (~275 MB).
# Os scripts que geram e consomem esses arquivos continuam versionados.
services/Meta/**/*.csv
services/Meta/**/*.csv.*
services/Meta/**/*.bak*
services/Meta/**/*.pre-dedup
services/Meta/**/*.log
services/Meta/**/__pycache__/
**/dados_brutos_completos*
**/detalhes_sorteios*
**/lista_unificada*
**/relatorio_financeiro*

# Logs operacionais e seus backups
**/*.log.bak*
apps/BI/**/*.log

# Estado de deduplicação da CAPI: listas de IDs já processados que crescem a
# cada execução e sujavam o repositório toda vez que o agregador rodava.
services/Meta/**/capi_*sent_ids*.json
services/Meta/**/checkpoint_*.json
