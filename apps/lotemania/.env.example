# lotemania — variáveis de ambiente
#
# Derivado do que o código de fato lê (`grep process.env` em src/, drizzle.config.ts
# e next.config.ts), não de um template genérico. Copie para `.env.local`.
#
# ATENÇÃO: o arquivo `.env.local` que veio no projeto original NÃO era um env —
# eram 2,9 KB de JavaScript com o nome trocado. Foi descartado na importação.

# ── Banco ────────────────────────────────────────────────────────────────
# Postgres do Neon, driver serverless. Hoje via neon-http, que NÃO suporta
# transação interativa — ver docs/architecture/adr/ quando a troca para
# neon-serverless (WebSocket) for feita.
DATABASE_URL=postgresql://user:senha@host.neon.tech/lotemania?sslmode=require

# ── Autenticação ─────────────────────────────────────────────────────────
# Assina os tokens de sessão. Gere com: openssl rand -base64 32
AUTH_SECRET=

# Cifra as credenciais de gateway de pagamento guardadas por tenant.
# Gere com: openssl rand -base64 32
# Trocar esta chave torna ilegível toda credencial já salva.
CREDENTIALS_ENCRYPTION_KEY=

# ── Seed (apenas desenvolvimento) ────────────────────────────────────────
# Usados por `pnpm db:seed` para criar o primeiro tenant e seu admin.
SEED_TENANT_SLUG=imperio
SEED_TENANT_NAME=Império Prêmios
# Obrigatórias: o seed falha se faltarem. Repositório público — nunca ponha
# valor real aqui, só em .env.local.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
