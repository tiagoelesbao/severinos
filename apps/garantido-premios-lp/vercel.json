{
  "rewrites": [
    { "source": "/l/:code", "destination": "https://link-garantido.vercel.app/api/r?code=:code" },
    { "source": "/tela-app-garantido.png", "destination": "/v2/tela-app-garantido.png" }
  ],
  "headers": [
    {
      "source": "/(.*)\\.(woff2|webp|png|ico)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=604800, stale-while-revalidate=86400" }
      ]
    }
  ]
}
